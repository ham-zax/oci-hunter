# ==========================================
# OCI HUNTER CONFIGURATION
# ==========================================

# OCI Tenancy & Region Details
COMPARTMENT_ID=ocid1.tenancy.oc1..aaaaaaaaxxxxxxxx
AVAILABILITY_DOMAIN=HKqY:AP-BATAM-1-AD-1
SUBNET_ID=ocid1.subnet.oc1.ap-batam-1.aaaaaaaaxxxxxxxx
IMAGE_ID=ocid1.image.oc1.ap-batam-1.aaaaaaaaxxxxxxxx

# Instance Customization
INSTANCE_NAME=your-instance-name
OCPUS=2
MEMORY_GB=12
BOOT_VOL_GB=50
SSH_PUBLIC_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI...

# Polling Interval & Limits
POLL_INTERVAL_MIN=45
POLL_INTERVAL_MAX=60

# Telegram Notification (Optional)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789
TELEGRAM_THREAD_ID=
