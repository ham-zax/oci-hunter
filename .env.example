# ==========================================
# OCI HUNTER CONFIGURATION
# ==========================================

# OCI CLI location. Leave unset to use /opt/oci-venv/bin/oci (README install path).
# Example: OCI_CLI_PATH=/home/you/.venvs/oci-cli/bin/oci

# OCI Tenancy & Region Details
COMPARTMENT_ID=ocid1.tenancy.oc1..aaaaaaaaxxxxxxxx
# Comma-separate several names to rotate through them (a single name is fine).
AVAILABILITY_DOMAIN=your_availability_domain
SUBNET_ID=ocid1.subnet.oc1.your_region.aaaaaaaaxxxxxxxx
IMAGE_ID=ocid1.image.oc1.your_region.aaaaaaaaxxxxxxxx

# Instance Customization
INSTANCE_NAME=your-instance-name
SHAPE=VM.Standard.A1.Flex
OCPUS=2
MEMORY_GB=12
BOOT_VOL_GB=50
SSH_PUBLIC_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI...

# Polling Interval & Limits
POLL_INTERVAL_MIN=45
POLL_INTERVAL_MAX=60

# Fault domains to rotate through, one per attempt. "auto" lets Oracle pick.
# Use API names (FAULT-DOMAIN-1), not the console's "FD-1" labels.
FAULT_DOMAINS=auto,FAULT-DOMAIN-1,FAULT-DOMAIN-2,FAULT-DOMAIN-3

# Telegram Notification (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
